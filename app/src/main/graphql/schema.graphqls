type PaymentIncrement {
  """
  The payment increment amount represented in various formats
  """
  amount: PaymentIncrementAmount!

  """
  If the payment increment has a backing, return human-readable information about the status of the payment increment
  """
  badge: PaymentIncrementBadge

  id: ID

  paymentIncrementableId: ID

  paymentIncrementableType: String

  """
  The original amount minus the refunded amount formatted in the project native currency
  """
  refundUpdatedAmountInProjectNativeCurrency: String

  """
  The total amount that has been refunded on the payment increment, across potentially multiple adjustments
  """
  refundedAmount: PaymentIncrementAmount

  scheduledCollection: ISO8601DateTime!

  """
  The state of the payment increment
  """
  state: PaymentIncrementState!

  stateReason: PaymentIncrementStateReason
}

"""
Representations of the payment increment amount with cents, float, and currency variations
"""
type PaymentIncrementAmount {
  """
  The increment amount in the smallest denomination of the currency, ie 3750 for the USD currency
  """
  amountAsCents: String!

  """
  The increment amount represented as a float, ie 37.50 for the USD currency
  """
  amountAsFloat: String!

  """
  The increment amount represented as a float with the currency symbol, ie $37.50
  """
  amountFormattedInProjectNativeCurrency: String!

  """
  The increment amount represented as a float with the currency symbol and three-letter currency code, ie $37.50 USD
  """
  amountFormattedInProjectNativeCurrencyWithCurrencyCode: String!

  """
  A three-letter currency code for the increment (ie the currency of the project)
  """
  currency: String!
}

"""
Representations of the payment increment badge information with badge title and style
"""
type PaymentIncrementBadge {
  """
  The title of the badge, representing the payment increment status
  """
  copy: String!

  """
  The variant of the badge, representing how the payment increment status is styled
  """
  variant: PaymentIncrementBadgeVariant!
}

enum PaymentIncrementBadgeVariant {
  """
  Background color for emphasizing important information
  """
  PURPLE

  """
  Background color for successful or positive actions
  """
  GREEN

  """
  Background color for errors or negative actions
  """
  RED

  """
  Background color for critical issues that need immediate attention
  """
  DANGER

  """
  Background color for neutral actions or states
  """
  GRAY
}

enum PaymentIncrementState {
  """
  The initial state of the payment increment; payment source has not been charged
  """
  UNATTEMPTED

  """
  Payment source was successfully charged
  """
  COLLECTED

  """
  Payment source could not be charged due to an errored payment source or authentication being required
  """
  ERRORED

  """
  Payment increment is cancelled by user action or is an abandoned increment due to failure to complete payment
  """
  CANCELLED

  """
  Backer issued a dispute and we (kickstarter) lost the dispute
  """
  CHARGEBACK_LOST

  """
  Payment increment has been refunded
  """
  REFUNDED

  """
  Payment increment amount has been adjusted due to refund and is unattempted
  """
  UNATTEMPTED_ADJUSTED

  """
  Payment increment amount has been adjusted due to refund and is collected
  """
  COLLECTED_ADJUSTED

  """
  Payment increment amount has been adjusted due to refund and is cancelled
  """
  CANCELLED_ADJUSTED

  """
  Payment increment amount has been adjusted due to refund and is errored
  """
  ERRORED_ADJUSTED
}

enum PaymentIncrementStateReason {
  """
  The increment was adjusted due to a refund
  """
  REFUND_ADJUSTED

  """
  The payment source has attempted to be charged, but issuer requires additional authentication to complete the payment
  """
  REQUIRES_ACTION
}

