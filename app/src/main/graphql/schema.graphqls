"""
A creator-initiated upgrade to a different reward
"""
type Upgrade {
  """
  The cost of this upgrade, after voucher is applied.
  """
  cost: Int!

  """
  The cost of this upgrade, after voucher is applied, formatted.
  """
  costFormatted: String!

  id: ID!

  """
  The reward being upgraded to
  """
  newReward: Reward!

  """
  The reward being upgrade from
  """
  previousReward: Reward!

  """
  The amount the backer has paid for the previous reward, in the user's chosen currency
  """
  previousRewardValueConvertedToCurrencyFormatted: String

  """
  The amount the backer has paid for the previous reward, credited against this upgrade.
  """
  previousRewardValueFormatted: String!

  """
  The answers to any questions associated with this upgrade
  """
  upgradeAnswers: [OrderEditAnswer!]!

  """
  The upgrade line items associated with the upgrade
  """
  upgradeLineItems: [OrderEditLineItem!]!
}

